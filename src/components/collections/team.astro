---
// Detail template of the team collection, Webflow's Team: one member at
// /team/<slug>, ported from detail_team.html. The photo, or its placeholder
// until the owner sends one, beside the back link, the role, the name, the
// short bio and a button.
import Title from "@hostsmith/site-kit-astro/components/Title.astro";
import { field } from "@hostsmith/site-kit-astro/field";
import { getUi } from "@hostsmith/site-kit-astro/ui";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"team">;
  locale?: string;
}

const { entry, locale } = Astro.props;
const { title, category, description, image, imageAlt } = entry.data;
const ref = `team/${entry.id}`;
const ui = await getUi(locale);
---

<section>
  <div class="mx-auto max-w-site px-gutter py-section">
    <div class="member">
      <div class="member__image">
        {image && <img src={image} alt={imageAlt} class="size-full object-cover" {...field(ref, "image")} />}
      </div>
      <div class="flex flex-col items-start gap-6">
        <a href="/about" class="post__back" {...ui.field("teamBack")}>{ui.text("teamBack")}</a>
        {
          category && (
            <p class="member__role" {...field(ref, "category")}>
              {category}
            </p>
          )
        }
        <h1 class="text-h2" {...field(ref, "title")}><Title text={title} /></h1>
        {
          description && (
            <p class="text-large text-muted" {...field(ref, "description")}>
              {description}
            </p>
          )
        }
        <a href="/contact" class="sk-button sk-button--primary" {...ui.field("teamButton")}>{ui.text("teamButton")}</a>
      </div>
    </div>
  </div>
</section>
