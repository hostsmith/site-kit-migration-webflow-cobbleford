---
// info-groups: short groups of practical details side by side, each with a
// heading and, in order, its lines of text, its rows (such as opening hours),
// its links and a note. As the old contact page's "Visit", "Opening hours"
// and "Get in touch". Props: items (title, text, rows (label, value), links,
// note). Text keeps its line breaks.
import { sectionFields } from "@hostsmith/site-kit-astro/field";

const { section, entry } = Astro.props;
const f = sectionFields(entry, section);
---

<section {...f.root} class="info-groups">
  <div class="sk-container">
    <ul class="info-groups__list">
      {
        section.items.map((item, i) => (
          <li class="info-groups__item">
            <h2 class="info-groups__title" {...f.field("items", i, "title")}>
              {item.title}
            </h2>
            {item.text && (
              <p class="info-groups__text" {...f.field("items", i, "text")}>
                {item.text.split("\n").map((line, l) => (l === 0 ? line : [<br />, line]))}
              </p>
            )}
            {item.rows && (
              <dl class="info-groups__rows">
                {item.rows.map((row, r) => (
                  <div class="info-groups__row">
                    <dt {...f.field("items", i, "rows", r, "label")}>{row.label}</dt>
                    <dd {...f.field("items", i, "rows", r, "value")}>{row.value}</dd>
                  </div>
                ))}
              </dl>
            )}
            {item.links && (
              <ul class="info-groups__links">
                {item.links.map((link, l) => (
                  <li>
                    <a href={link.link} class="info-groups__link" {...f.field("items", i, "links", l, "label")}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
            {item.note && (
              <p class="info-groups__note" {...f.field("items", i, "note")}>
                {item.note}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
