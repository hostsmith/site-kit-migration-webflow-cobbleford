---
// plan-cards: membership plans as cards side by side, each with its name, its
// price and period, what it includes (markdown) and a button. Props: items
// (name, price, period, features, button).
import { sectionFields } from "@hostsmith/site-kit-astro/field";
import { renderMarkdown } from "@hostsmith/site-kit-astro/markdown";

const { section, entry } = Astro.props;
const f = sectionFields(entry, section);
const features = await Promise.all(
  section.items.map((item, i) => renderMarkdown(item.features, `${entry} section "${section.id}" (plan-cards) items[${i}].features`, entry)),
);
---

<section {...f.root} class="plan-cards">
  <div class="sk-container">
    <ul class="plan-cards__list">
      {
        section.items.map((item, i) => (
          <li class="plan-cards__card">
            <div class="plan-cards__header">
              <h2 class="plan-cards__name" {...f.field("items", i, "name")}>
                {item.name}
              </h2>
              <p class="plan-cards__price-row">
                <span class="plan-cards__price" {...f.field("items", i, "price")}>
                  {item.price}
                </span>
                {item.period && (
                  <span class="plan-cards__period" {...f.field("items", i, "period")}>
                    {item.period}
                  </span>
                )}
              </p>
            </div>
            <div class="plan-cards__features sk-prose" {...f.field("items", i, "features")} set:html={features[i]} />
            <a href={item.button.link} class="sk-button sk-button--primary plan-cards__button" {...f.field("items", i, "button", "label")}>
              {item.button.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
